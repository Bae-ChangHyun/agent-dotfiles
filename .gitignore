# Never commit these
*.key
*.pem
id_rsa
id_ed25519
*_rsa
*_ed25519
.env
.env.*
!.env.example

# Editor / OS junk
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# chezmoi state (per-machine)
.chezmoidata.local.*
.chezmoistate

# Claude Code가 chezmoi 디렉토리에서 작업할 때 자동 생성하는 파일
.claude/
.codex/

# Don't commit unencrypted secrets — age 암호화 파일만 허용
secrets/*
!secrets/.gitkeep
!secrets/*.age
